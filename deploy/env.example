# Copy to deploy/.env on the server and fill in. Names only here: no real value is ever committed.
# How to generate each secret is written above it: the commands differ.

# The two public names (DNS A records pointing at this server)
APP_DOMAIN=app.example.com
WS_DOMAIN=ws.example.com

# The database: a managed PostgreSQL 17 outside this server (ADR-152). The whole address in one line:
#   postgres://<user>:<password>@<host>:5432/hapiecoin?sslmode=require
# The password sits inside an address, so any character other than a letter or a digit in it must be
# percent-encoded (@ is %40, / is %2F, : is %3A, # is %23, ? is %3F, % is %25); the simplest is to set a
# password of letters and digits only on the database:  openssl rand -hex 24
DATABASE_URL=

# Sessions (at least 32 characters):  openssl rand -base64 48
# The vault key for stored exchange keys (ADR-054), exactly 32 bytes in base64:  openssl rand -base64 32
# Generate once, keep safe: losing CREDENTIALS_ENC_KEY makes stored exchange keys unreadable.
# When the database is restored from another machine (docs/deploy.md §6.3), both must be that machine's values.
BETTER_AUTH_SECRET=
CREDENTIALS_ENC_KEY=

# Sign-in codes are sent by email through Resend; the API refuses to start in production without the key.
RESEND_API_KEY=
EMAIL_FROM=HapieCoin <no-reply@example.com>

# Bearer token for /metrics on the API and the gateway (8 characters or more):  openssl rand -hex 24
METRICS_TOKEN=

# The release to run: the full git commit of main whose images GitHub built (the tag of the four images).
# It is also shown in error reports. Change it and run `pull` then `up -d` to update or to roll back.
RELEASE=

# The GitHub account that owns the images, in lower case (ghcr.io/<IMAGE_OWNER>/hapiecoin-web and so on)
IMAGE_OWNER=

# This server's public IPv4 address: what a trader whitelists at the exchange for an API key
EGRESS_IP=

# true: no NEW live order can be placed from this copy. Leave it so for the private copy.
# It does not stop a close or a cancel on a live strategy that is already in the database (GAPS #186).
TRADING_DISABLED=true

# Where signed exchange calls go. It must be the exchange environment the stored keys belong to: for a
# database restored from another machine, the value that machine used.
DELTA_TRADING_REST_URL=

# Optional
# The vault keys used before a rotation, comma-separated (ADR-054)
CREDENTIALS_ENC_KEYS_PREVIOUS=
# Where backup.sh copies each good dump off this server: an rsync target such as user@host:/path. Empty = no copy.
BACKUP_COPY_TO=
TELEGRAM_BOT_TOKEN=
ERROR_SINK_DSN=
COINGECKO_API_KEY=
