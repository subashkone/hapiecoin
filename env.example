# Copy to .env (never committed). Values are examples for local development only.
NODE_ENV=development

# Database and cache (docker compose defaults)
DATABASE_URL=postgres://hapiecoin:hapiecoin@localhost:5432/hapiecoin
REDIS_URL=redis://localhost:6379

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-random-string
# Public origin auth URLs are built from (OAuth callbacks). Leave empty to use WEB_URL: the browser reaches the API
# through the web app's /v1/* rewrite, so the Google callback must land on the web origin (ADR-019).
BETTER_AUTH_URL=
# Socket addresses whose cf-connecting-ip / x-forwarded-for / x-real-ip headers are trusted (comma separated).
# Empty: the socket address is the client IP. Local dev behind the Next.js proxy: 127.0.0.1,::1. Never "*" in production.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# API process (apps/api)
API_PORT=3001
# fatal|error|warn|info|debug|trace|silent (default info; tests use silent)
LOG_LEVEL=
# Development without Docker: leave DATABASE_URL empty to use embedded PGlite; set a directory to persist it
PGLITE_DATA_DIR=
# Google OAuth (optional in development; leave empty to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (development prints OTP codes to the API log when RESEND_API_KEY is empty)
# Required in production (the API refuses to boot without it: the fallback mailer logs OTPs, dev/test only)
RESEND_API_KEY=
EMAIL_FROM=HapieCoin <no-reply@hapiecoin.com>

# Encryption key for exchange API credentials at rest (32 bytes, base64)
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Required in production.
# In development an unset key is derived from BETTER_AUTH_SECRET so saved exchange keys survive restarts.
CREDENTIALS_ENC_KEY=

# Copy this file to `.env` at the repository root: the API and the gateway load it at boot in development
# (shell variables win on conflict; production injects real environment variables and needs no file).
# Delta Exchange India (public market data needs no key; trading keys are per user and stored encrypted)
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange
# Base URL for every private (signed) call: credential checks and live orders (ADR-025). Leave empty for
# production; set the testnet base while trading with a demo.delta.exchange key.
DELTA_TRADING_REST_URL=https://cdn-ind.testnet.deltaex.org
# Live-trading safeguards (ADR-025): global kill switch and per-placement limits
TRADING_DISABLED=
TRADING_MAX_NOTIONAL_USD=100000
TRADING_MAX_LEGS=10
TRADING_MARK_BAND_PCT=5
# Egress IP users must whitelist at Delta for their API key (placeholder until production egress is fixed)
EGRESS_IP=172.236.179.136
# Live trading keys (absent in test; never in code, logs or chat). For Phase 3 item 2 use a TESTNET key from a
# https://demo.delta.exchange account together with the testnet REST base https://cdn-ind.testnet.deltaex.org
# (production keys do not work against the testnet and vice versa).
DELTA_API_KEY=
DELTA_API_SECRET=

# Payments (phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Apps
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
GATEWAY_URL=ws://localhost:3002

# Web app (apps/web). NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Browser → gateway WebSocket URL (also used for GET /healthz expiry discovery)
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:3002
# Show "Continue with Google" on /auth only when the API has Google OAuth configured
NEXT_PUBLIC_GOOGLE_ENABLED=false
# Expiry chips fallback (ISO dates, comma separated) when the gateway /healthz has none
NEXT_PUBLIC_DEFAULT_EXPIRIES=2026-09-11,2026-09-18,2026-09-25,2026-10-30,2026-11-27
# Playwright e2e ports (apps/web/playwright.config.ts): web, mock API, fake gateway
E2E_WEB_PORT=3100
MOCK_API_PORT=3101
MOCK_GATEWAY_PORT=3102
# Gateway hardening (GAPS #30): bearer token required on /metrics when set; sockets allowed per client address
METRICS_TOKEN=
MAX_CONNECTIONS_PER_IP=20
