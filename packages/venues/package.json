{
  "name": "@hapiecoin/venues",
  "version": "0.1.0",
  "private": true,
  "description": "HapieCoin venue adapters: the venue port (ADR-063) with Delta Exchange India behind it, Binance spot; `./core` is the browser-safe part",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "development": "./src/port/core.ts",
      "types": "./dist/port/core.d.ts",
      "default": "./dist/port/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:delta": "tsx scripts/smoke-delta.ts"
  },
  "dependencies": {
    "@hapiecoin/schema": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@hapiecoin/config": "workspace:*",
    "tsx": "4.23.13"
  }
}
